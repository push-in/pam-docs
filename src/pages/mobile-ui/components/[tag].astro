---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import evidenceContract from '../../../data/mobile-ui-evidence.json';
import componentContract from '../../../data/mobile-ui-components.json';

type ComponentContract = (typeof componentContract.components)[number];

export function getStaticPaths() {
  const screenshots = import.meta.glob('../../../assets/mobile-ui/components/p-*.png', {
    eager: true,
    query: '?url',
    import: 'default',
  });
  const recordings = import.meta.glob('../../../assets/mobile-ui/gifs/p-*.gif', {
    eager: true,
    query: '?url',
    import: 'default',
  });
  const gifByTag = new Map(
    Object.entries(recordings).map(([path, url]) => [
      path.split('/').pop()?.replace(/\.gif$/, '') ?? '',
      String(url),
    ]),
  );
  const entries = Object.entries(screenshots)
    .map(([path, url]) => ({
      tag: path.split('/').pop()?.replace(/\.png$/, '') ?? '',
      screenshotUrl: String(url),
      component: componentContract.components.find((entry) => entry.tag === path.split('/').pop()?.replace(/\.png$/, '')),
    }))
    .sort((left, right) => left.tag.localeCompare(right.tag));

  return entries.map((entry, index) => ({
    params: { tag: entry.tag },
    props: {
      ...entry,
      gifUrl: gifByTag.get(entry.tag),
      previous: entries[index - 1]?.tag,
      next: entries[index + 1]?.tag,
    },
  }));
}

interface Props {
  tag: string;
  screenshotUrl: string;
  gifUrl?: string;
  previous?: string;
  next?: string;
  component: ComponentContract;
}

const { tag, screenshotUrl, gifUrl, previous, next, component } = Astro.props as Props;
const isStatic = evidenceContract.staticComponents.includes(tag);
const title = tag
  .replace(/^p-/, '')
  .split('-')
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(' ');
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const componentBase = `${siteBase}mobile-ui/components`;
const exampleProps = component.props
  .filter((prop) => prop.examples.length > 0)
  .sort((left, right) => Number(right.name === 'variant') - Number(left.name === 'variant'))
  .slice(0, 3);
const usage = [
  `use ${component.namespace};`,
  'use Pam\\Native\\UI\\Text;',
  '',
  `${component.class}::make(`,
  ...(exampleProps.length > 0
    ? [
        '    [',
        ...exampleProps.map((prop) => `        '${prop.name}' => ${prop.examples[0]},`),
        '    ],',
      ]
    : ['    [],']),
  `    Text::make('${title}'),`,
  ');',
].join('\n');
---

<StarlightPage frontmatter={{
  title: `${title} — PAM Native UI`,
  description: `${tag} rendered and validated on the retained-native Android showcase.`,
}}>
  <p class="eyebrow">PAM Native UI · Android evidence</p>
  <p class="lead">
    <code>{tag}</code> rendered by the production retained-native pipeline. The specimen below is a real
    Physical Samsung SM-G973F Android 12 (API 31) capture at 420 dpi, not an
    HTML recreation.
  </p>

  <div class="status-line" role="status">
    <span aria-hidden="true"></span>
    {isStatic ? 'Emulator layout and component route verified' : 'Emulator layout, route and native interaction verified'}
  </div>

  <dl class="component-facts">
    <div><dt>Family</dt><dd>{component.family}</dd></div>
    <div><dt>Module</dt><dd><code>{component.module}</code></dd></div>
    <div><dt>PHP facade</dt><dd><code>{component.class}</code></dd></div>
    <div><dt>Native targets</dt><dd>Android · UIKit</dd></div>
  </dl>

  <p class="summary">{component.summary}</p>

  <section aria-labelledby="visual-heading">
    <h2 id="visual-heading">Android specimen</h2>
    <a class="device-shot" href={screenshotUrl} aria-label={`Open the full-size ${tag} Android screenshot`}>
      <img src={screenshotUrl} alt={`${tag} running in the PAM Native UI Android catalog`} width="1080" height="2400" />
    </a>
  </section>

  {gifUrl && (
    <section aria-labelledby="interaction-heading">
      <h2 id="interaction-heading">Interaction recording</h2>
      <p>The touch trace was captured from the Android application while exercising the native component.</p>
      <a class="device-shot" href={gifUrl} aria-label={`Open the full-size ${tag} interaction recording`}>
        <img src={gifUrl} alt={`${tag} native Android interaction`} width="360" height="800" loading="lazy" />
      </a>
    </section>
  )}

  {isStatic && (
    <p class="static-note">
      This is a static or anatomical component. Its Android evidence is the rendered specimen; no synthetic
      interaction recording is published.
    </p>
  )}

  <section aria-labelledby="profiles-heading">
    <h2 id="profiles-heading">Showcase profiles</h2>
    <p>Every profile below is rendered by the Android catalog route shown above.</p>
    <ul class="profile-list">
      {component.profiles.map((profile) => <li>{profile}</li>)}
    </ul>
  </section>

  <section aria-labelledby="usage-heading">
    <h2 id="usage-heading">PHP usage</h2>
    <pre><code>{usage}</code></pre>
    <p>The equivalent PAM template entry point is <code>{`<${tag}>…</${tag}>`}</code>.</p>
    <p>
      See the <a href={`${siteBase}packages/mobile-ui/`}>PAM Native UI guide</a> for event,
      state and styling conventions, and the <a href={`${siteBase}packages/mobile-ui-architecture/`}>quality contract</a>
      for native behavior requirements.
    </p>
  </section>

  <section aria-labelledby="props-heading">
    <h2 id="props-heading">Component properties</h2>
    {component.props.length > 0 ? (
      <div class="table-scroll" tabindex="0" role="region" aria-label={`${tag} properties`}>
        <table>
          <thead><tr><th scope="col">Property</th><th scope="col">Observed type</th><th scope="col">Showcase values</th></tr></thead>
          <tbody>
            {component.props.map((prop) => (
              <tr>
                <th scope="row"><code>{prop.name}</code></th>
                <td>{prop.types.join(' | ')}</td>
                <td>{prop.examples.length > 0 ? prop.examples.join(', ') : 'Structured value'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p>This anatomical component uses content and inherited theme/style properties.</p>
    )}
  </section>

  {component.related.length > 0 && (
    <section aria-labelledby="related-heading">
      <h2 id="related-heading">Related component parts</h2>
      <ul class="related-list">
        {component.related.map((related) => <li><a href={`${componentBase}/${related}/`}><code>{related}</code></a></li>)}
      </ul>
    </section>
  )}

  <nav class="component-pagination" aria-label="Component catalog pagination">
    {previous ? <a href={`${componentBase}/${previous}/`}>← <code>{previous}</code></a> : <span></span>}
    <a href={`${siteBase}packages/mobile-ui-catalog/`}>All components</a>
    {next ? <a href={`${componentBase}/${next}/`}><code>{next}</code> →</a> : <span></span>}
  </nav>
</StarlightPage>

<style>
  .eyebrow { margin: 0 0 0.5rem; color: var(--sl-color-text-accent); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .lead { max-width: 46rem; font-size: 1.08rem; }
  .status-line { display: flex; align-items: center; gap: 0.65rem; margin-block: 1.5rem 2.5rem; color: var(--sl-color-text); font-weight: 650; }
  .status-line span { width: 0.7rem; height: 0.7rem; border-radius: 999px; background: #16803c; box-shadow: 0 0 0 0.25rem color-mix(in srgb, #16803c 18%, transparent); }
  .static-note { max-width: 46rem; color: var(--sl-color-gray-2); }
  .summary { max-width: 46rem; }
  section { margin-block: 2.75rem; }
  .device-shot { display: block; width: min(100%, 27rem); padding: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 1.25rem; overflow: hidden; background: var(--sl-color-bg-nav); box-shadow: 0 0.9rem 2.4rem color-mix(in srgb, #0f172a 14%, transparent); }
  .device-shot img { display: block; width: 100%; height: auto; margin: 0; }
  pre { max-width: 46rem; }
  .component-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0; max-width: 52rem; margin-block: 1.5rem 2rem; border-block: 1px solid var(--sl-color-gray-5); }
  .component-facts div { padding: 0.9rem 1rem 0.9rem 0; }
  .component-facts dt { color: var(--sl-color-gray-2); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .component-facts dd { margin: 0.25rem 0 0; font-weight: 650; }
  .profile-list, .related-list { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .profile-list li { padding: 0.35rem 0.7rem; border: 1px solid var(--sl-color-gray-5); border-radius: 999px; color: var(--sl-color-gray-1); font-size: 0.84rem; }
  .related-list a { display: inline-flex; min-height: 2.75rem; align-items: center; padding-inline: 0.7rem; }
  .table-scroll { max-width: 52rem; overflow-x: auto; border-block: 1px solid var(--sl-color-gray-5); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { padding: 0.8rem 1rem 0.8rem 0; border-block-end: 1px solid var(--sl-color-gray-6); text-align: left; vertical-align: top; }
  thead th { color: var(--sl-color-gray-2); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .component-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-top: 4rem; padding-top: 1.25rem; border-top: 1px solid var(--sl-color-gray-5); }
  .component-pagination a { text-decoration: none; }
  .component-pagination a:last-child { text-align: right; }
  @media (max-width: 40rem) { .component-pagination { grid-template-columns: 1fr 1fr; } .component-pagination > :nth-child(2) { order: 3; grid-column: 1 / -1; text-align: center; } }
  @media (prefers-reduced-motion: reduce) { .device-shot { scroll-behavior: auto; } }
</style>
