---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${value}`;
---

<div class="pam-home">
  <section class="pam-home-hero" aria-labelledby="pam-home-title">
    <div class="pam-home-copy">
      <p class="pam-home-kicker">PHP, always in memory</p>
      <h2 class="pam-home-title" id="pam-home-title">The persistent stack for PHP applications.</h2>
      <p class="pam-home-lead">
        Build long-lived servers, Laravel applications, real native Android interfaces,
        and desktop software — with PHP at the center and Rust at the boundary.
      </p>
      <div class="pam-home-actions">
        <a class="pam-button pam-button-primary" href={path('/getting-started/installation/')}>
          Get started
          <span aria-hidden="true">→</span>
        </a>
        <a class="pam-button pam-button-secondary" href={path('/introduction/')}>
          Read the documentation
        </a>
      </div>
    </div>

    <div class="pam-runtime-visual" aria-label="PAM connects Composer PHP to native application targets">
      <svg viewBox="0 0 680 600" role="img" aria-labelledby="runtime-visual-title runtime-visual-description">
        <title id="runtime-visual-title">The PAM application stack</title>
        <desc id="runtime-visual-description">Composer and PHP run through PAM into server, Android, and desktop targets.</desc>
        <defs>
          <pattern id="pam-grid" width="42" height="24" patternUnits="userSpaceOnUse" patternTransform="skewY(-30)">
            <path d="M42 0H0V24" fill="none" stroke="#dedede" stroke-width="1"/>
          </pattern>
          <filter id="pam-shadow" x="-30%" y="-30%" width="160%" height="180%">
            <feDropShadow dx="0" dy="12" stdDeviation="8" flood-color="#111" flood-opacity=".14"/>
          </filter>
        </defs>
        <rect width="680" height="600" fill="url(#pam-grid)" opacity=".65"/>

        <g class="pam-route-lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M40 498 246 380" stroke="#ff2d20" stroke-width="3"/>
          <path d="M80 548 270 438" stroke="#246bfe" stroke-width="3"/>
          <path d="M438 508 618 404" stroke="#232323" stroke-width="2"/>
          <circle cx="170" cy="423" r="7" fill="#fff" stroke="#ff2d20" stroke-width="3"/>
          <circle cx="215" cy="397" r="7" fill="#fff" stroke="#ff2d20" stroke-width="3"/>
          <circle cx="175" cy="493" r="7" fill="#fff" stroke="#246bfe" stroke-width="3"/>
        </g>

        <g filter="url(#pam-shadow)">
          <g transform="translate(254 105)">
            <path d="m0 55 155-55 155 55-155 56Z" fill="#eef4ff" stroke="#1e1e1e" stroke-width="2"/>
            <path d="m0 55 155 56v72L0 127Z" fill="#d8e5ff" stroke="#1e1e1e" stroke-width="2"/>
            <path d="m310 55-155 56v72l155-56Z" fill="#b9d0ff" stroke="#1e1e1e" stroke-width="2"/>
            <text x="155" y="70" text-anchor="middle" fill="#1a1a1a" font-size="22" font-weight="700">COMPOSER</text>
          </g>
          <g transform="translate(254 230)">
            <path d="m0 35 155-56 155 56-155 56Z" fill="#fff4f1" stroke="#1e1e1e" stroke-width="2"/>
            <path d="m0 35 155 56v92L0 127Z" fill="#ffc9c1" stroke="#1e1e1e" stroke-width="2"/>
            <path d="m310 35-155 56v92l155-56Z" fill="#ff806f" stroke="#1e1e1e" stroke-width="2"/>
            <text x="155" y="53" text-anchor="middle" fill="#ff2d20" font-size="28" font-weight="800">PHP 8.4</text>
          </g>
          <g transform="translate(254 363)">
            <path d="m0 35 155-56 155 56-155 56Z" fill="#ff493d" stroke="#1e1e1e" stroke-width="2"/>
            <path d="m0 35 155 56v106L0 141Z" fill="#ff2d20" stroke="#1e1e1e" stroke-width="2"/>
            <path d="m310 35-155 56v106l155-56Z" fill="#d91d12" stroke="#1e1e1e" stroke-width="2"/>
            <text x="155" y="56" text-anchor="middle" fill="#fff" font-size="42" font-weight="800" font-style="italic">PAM</text>
            <text x="155" y="121" text-anchor="middle" fill="#fff" font-size="18" font-weight="700">RUST · TOKIO · ZEND</text>
          </g>
        </g>

        <g class="pam-target-chip">
          <rect x="26" y="466" width="138" height="40" rx="20" fill="#fff" stroke="#ff2d20" stroke-width="2"/>
          <text x="95" y="492" text-anchor="middle">HTTP + SOCKETS</text>
        </g>
        <g class="pam-target-chip">
          <rect x="52" y="526" width="126" height="40" rx="20" fill="#fff" stroke="#246bfe" stroke-width="2"/>
          <text x="115" y="552" text-anchor="middle">ANDROID</text>
        </g>
        <g class="pam-target-chip">
          <rect x="514" y="382" width="120" height="40" rx="20" fill="#fff" stroke="#232323" stroke-width="2"/>
          <text x="574" y="408" text-anchor="middle">DESKTOP</text>
        </g>
      </svg>
    </div>
  </section>

  <section class="pam-platform-strip" aria-label="PAM platform areas">
    <p>ONE RUNTIME.<br/>FOUR TARGETS.</p>
    <a href={path('/runtime/how-pam-works/')}><strong>Server</strong><span>HTTP, WebSockets, async I/O</span></a>
    <a href={path('/laravel/overview/')}><strong>Laravel</strong><span>Boot once, isolate every request</span></a>
    <a href={path('/native/overview/')}><strong>Android</strong><span>Real native Views from PHP</span></a>
    <a href={path('/desktop/overview/')}><strong>Desktop</strong><span>Secure Servo-powered windows</span></a>
  </section>

  <section class="pam-home-section pam-home-intro" aria-labelledby="beyond-request">
    <div>
      <p class="pam-home-kicker">The runtime</p>
      <h2 id="beyond-request">PHP beyond the request.</h2>
    </div>
    <div>
      <p>
        PAM embeds PHP 8.4 through the official Embed SAPI and keeps your application alive.
        Composer stays familiar while Rust and Tokio own scheduling, native I/O, and process supervision.
      </p>
      <a class="pam-text-link" href={path('/runtime/how-pam-works/')}>See how PAM works <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="pam-feature-grid" aria-label="PAM capabilities">
    <a href={path('/runtime/http/')}>
      <span class="pam-feature-number">01</span>
      <h3>Persistent servers</h3>
      <p>Serve HTTP, WebSockets, streams, and async I/O without rebuilding PHP for every request.</p>
    </a>
    <a href={path('/laravel/request-lifecycle/')}>
      <span class="pam-feature-number">02</span>
      <h3>Laravel, kept familiar</h3>
      <p>Boot the framework once while preserving request isolation, Artisan, queues, and Composer packages.</p>
    </a>
    <a href={path('/native/components/')}>
      <span class="pam-feature-number">03</span>
      <h3>Actual native UI</h3>
      <p>Describe interfaces in PHP and render real Android Views through PAM's typed component protocol.</p>
    </a>
  </section>

  <section class="pam-home-status" aria-labelledby="honest-status">
    <div>
      <p class="pam-home-kicker">Open development</p>
      <h2 id="honest-status">Ambitious software. Honest status.</h2>
    </div>
    <div>
      <p>
        PAM is experimental. Android API 26–36 is the current mobile target, and an iOS renderer
        has not been implemented yet. Every guide tells you what works, what is partial, and where
        a contribution can move the project forward.
      </p>
      <div class="pam-home-actions">
        <a class="pam-button pam-button-primary" href={path('/project/status/')}>View project status</a>
        <a class="pam-button pam-button-secondary" href={path('/community/contributing/')}>Contribute to PAM</a>
      </div>
    </div>
  </section>
</div>
