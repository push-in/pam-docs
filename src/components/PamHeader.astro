---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${value}`;
const isHome = Astro.url.pathname === path('/');
---

{
  isHome ? (
    <>
      <div class="pam-release-bar">
        <span><strong>PAM 1.0</strong> is available.</span>
        <a href={path('/project/release-1-0-0/')}>Read the verified release record <span aria-hidden="true">→</span></a>
      </div>
      <header class="pam-home-header">
        <a class="pam-home-brand" href={path('/')} aria-label="PAM home">
          <strong>PAM</strong>
        </a>
        <nav aria-label="Primary navigation">
          <a href={path('/runtime/how-pam-works/')}>Server</a>
          <a href={path('/laravel/overview/')}>Laravel</a>
          <a href={path('/native/overview/')}>Native</a>
          <a href={path('/packages/overview/')}>Packages</a>
        </nav>
        <div class="pam-home-tools">
          <a href="https://github.com/push-in/pam" aria-label="PAM on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.94 10.94 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/>
            </svg>
          </a>
          <a class="pam-header-search" href={path('/introduction/')} aria-label="Open PAM documentation">
            <span>Open docs</span>
            <strong aria-hidden="true">→</strong>
          </a>
        </div>
      </header>
    </>
  ) : (
    <DefaultHeader />
  )
}
