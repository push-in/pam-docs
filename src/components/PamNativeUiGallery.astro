---
const modules = import.meta.glob('../assets/mobile-ui/components/p-*.png', {
  eager: true,
  query: '?url',
  import: 'default',
});

const gifModules = import.meta.glob('../assets/mobile-ui/gifs/p-*.gif', {
  eager: true,
  query: '?url',
  import: 'default',
});

const gifs = new Map(
  Object.entries(gifModules).map(([path, url]) => [
    path.split('/').pop()?.replace(/\.gif$/, '') ?? '',
    String(url),
  ]),
);

const images = Object.entries(modules)
  .map(([path, url]) => ({
    tag: path.split('/').pop()?.replace(/\.png$/, '') ?? '',
    url: String(url),
    gifUrl: gifs.get(path.split('/').pop()?.replace(/\.png$/, '') ?? ''),
  }))
  .sort((left, right) => left.tag.localeCompare(right.tag));
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const componentBase = `${siteBase}mobile-ui/components`;
---

<div class="pam-native-ui-gallery" aria-label="PAM Native UI Android component screenshots">
  {images.map(({ tag, url, gifUrl }) => (
    <figure>
      <a href={`${componentBase}/${tag}/`} aria-label={`Open the ${tag} component documentation`}>
        <img
          src={url}
          alt={`${tag} rendered by PAM Native UI on a physical Samsung Android device`}
          width="1080"
          height="2280"
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption>
        <a class="component-link" href={`${componentBase}/${tag}/`}><code>{tag}</code></a>
        {gifUrl && (
          <a class="interaction-link" href={gifUrl} aria-label={`Open the verified ${tag} Android interaction GIF`}>
            Interaction GIF <span aria-hidden="true">↗</span>
          </a>
        )}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .pam-native-ui-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 1.25rem;
    margin-block: 1.5rem 2rem;
  }

  figure {
    margin: 0;
    padding-block-end: 0.9rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  a {
    display: block;
    overflow: hidden;
    height: 26rem;
    background: var(--sl-color-bg-nav);
  }

  img {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    object-position: top center;
    transition: transform 160ms ease;
  }

  a:hover img,
  a:focus-visible img {
    transform: scale(1.025);
  }

  a:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: -3px;
  }

  figcaption {
    display: flex;
    min-height: 2.75rem;
    padding-block-start: 0.7rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .interaction-link {
    display: inline-flex;
    height: auto;
    color: var(--sl-color-text-accent);
    background: transparent;
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
  }

  .component-link {
    display: inline-flex;
    height: auto;
    color: var(--sl-color-text);
    background: transparent;
    text-decoration: none;
  }

  .component-link:hover {
    color: var(--sl-color-text-accent);
  }

  .interaction-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
